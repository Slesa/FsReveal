<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net7.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Domain.fs"/>
        <Compile Include="Misc.fs"/>
        <Compile Include="Markdown.fs"/>
        <Compile Include="Formatting.fs"/>
        <Compile Include="FsReveal.fs"/>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="FSharp.Core" Version="7.0.400" />
      <PackageReference Include="FSharp.Compiler.Service" Version="43.7.400" />
      <PackageReference Include="FSharp.Formatting" Version="19.1.1" />
      <PackageReference Include="FSharp.Formatting.Literate" Version="19.1.1" />
      <PackageReference Include="FSharp.Formatting.Markdown" Version="1.0.0" />
    </ItemGroup>

</Project>
